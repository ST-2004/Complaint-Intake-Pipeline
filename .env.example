# Names only. Real values are written by `python tasks.py env` from terraform outputs.
AZURE_LANGUAGE_ENDPOINT=https://<language-subdomain>.cognitiveservices.azure.com/
AZURE_AI_ENDPOINT=https://<ai-subdomain>.openai.azure.com/openai/v1/
MODEL_DEPLOYMENT=<deployment-name>
# Token scope for the model endpoint. If you get 401s, try https://ai.azure.com/.default
AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# azure | presidio
PII_PROVIDER=azure
DB_PATH=./triage.db
