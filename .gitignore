# Secrets and local config
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Terraform: never commit state or plans (they can hold sensitive values).
# .terraform.lock.hcl IS committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Evaluation scratch (cache holds redacted output only, still local)
eval/.cache/
data/relabel_sample.jsonl
eval/reports/*_MOCK.*
eval/reports/baseline_*_mock.json

# Local data stores
*.db
*.sqlite
*.sqlite3

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
